{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myaitoimg",
  "version": "0.1.0",
  "identifier": "de.xinai.myaitoimg",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "myaitoimg",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "myaitoimg node canvas image generation workbench",
    "longDescription": "myaitoimg by 小沨, xinai.de. A Tauri and Vue desktop workbench for OpenAI and Gemini image generation."
  }
}
