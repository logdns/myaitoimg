{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myaitoimg",
  "version": "0.1.4",
  "identifier": "de.xinai.myaitoimg",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "myaitoimg",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "小沨, xinai.de",
    "homepage": "https://xinai.de",
    "copyright": "Copyright © 2026 小沨, xinai.de. All rights reserved.",
    "licenseFile": "INSTALLER.rtf",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "myaitoimg 是小沨（xinai.de）制作的节点式 AI 图片生成工作台。",
    "longDescription": "myaitoimg 由小沨（xinai.de）制作。它是一个面向桌面端的节点式 AI 图片生成工作台，支持 OpenAI、Gemini 和中转 API，可进行文生图、图片编辑、参考图、蒙版、尺寸、质量、格式、透明背景、压缩参数等工作流配置。",
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "myaitoimg"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBNDI1QTY0QzE2NTA3RUYKUldUdkIyWEJaRnBDR3JyMk9KcU5oMkRkUUFiTW42TERDUW5UelZPTVRtQnlIMEh1SjQ5OEt1aDkK",
      "endpoints": [
        "https://github.com/logdns/myaitoimg/releases/latest/download/latest.json"
      ]
    }
  }
}
